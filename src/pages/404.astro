---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn’t exist.">
  <section class="not-found grow">
    <div class="eyebrow eyebrow--lg">404</div>
    <h1 class="h1">This page doesn’t exist.</h1>
    <p class="lede">The link may be out of date. Everything on the site is one click from the home page.</p>
    <div class="not-found__actions">
      <a class="btn" href="/">Go to the home page</a>
      <a class="textlink" href="/contact">What happens next</a>
    </div>
  </section>
</Base>
